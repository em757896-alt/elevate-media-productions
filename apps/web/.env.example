# Supabase (leave blank to run on seeded data — fill later)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-ONLY — never expose to the browser).
# Required only for admin account deletion (/api/account/delete).
# Found in Supabase Dashboard → Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=

# Brevo transactional email (required for contact form + newsletter)
# https://app.brevo.com/settings/keys/smtp → copy the key here
BREVO_API_KEY=

# Cloudflare Turnstile bot protection (optional — degrades cleanly when blank)
# dash.cloudflare.com → Turnstile → Add Site (domain: elevate-media-productions.vercel.app)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional overrides (defaults shown)
# CONTACT_SENDER=elevatemediaproductions1@gmail.com
# CONTACT_TO=elevatemediaproductions1@gmail.com
# CONTACT_SENDER_NAME=Elevate Media Productions

# Optional Upstash Redis for cross-instance rate limiting (falls back to in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Dev-facing URL used in confirmation emails (defaults to the Vercel production URL)
# SITE_URL=https://elevate-media-productions.vercel.app